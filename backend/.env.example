# Copy this file to .env and fill in real values as needed.

SECRET_KEY=change-this-secret
JWT_SECRET_KEY=change-this-jwt-secret

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

ADMIN_EMAIL=admin@ppa.com
ADMIN_PASSWORD=Admin@123

# Optional: SMTP for real emails (reminders / monthly report). Leave blank to just log to console.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional: Google Chat webhook URL for reminders
GCHAT_WEBHOOK_URL=
